SONAR_BIND=127.0.0.1:3002
SONAR_DATA_DIR=/var/lib/sonar
RUST_LOG=info

# Require "Authorization: Bearer <key>" on API routes.
#SONAR_API_KEY=
#SEARXNG_ENDPOINT=http://127.0.0.1:8080
#SONAR_USER_AGENT=
# Ports allowed besides 80 and 443, comma separated.
#SONAR_EXTRA_PORTS=
# Limits (defaults shown).
#SONAR_GLOBAL_CONCURRENCY=256
#SONAR_PER_HOST_CONCURRENCY=2
#SONAR_PER_HOST_SPACING_MS=250
#SONAR_MAX_TIMEOUT_MS=120000
#SONAR_DEFAULT_MAX_AGE_MS=86400000
#SONAR_MAX_BODY_BYTES=10485760
