[Unit]
Description=DripSonar web research engine
After=network-online.target
Wants=network-online.target

[Service]
User=sonar
Group=sonar
EnvironmentFile=/etc/sonar/sonar.env
ExecStart=/usr/local/bin/sonar serve
Restart=always
RestartSec=2
TimeoutStopSec=30
LimitNOFILE=1048576

# Hardening. MemoryDenyWriteExecute is deliberately unset: the browser tier needs JIT.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sonar
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
