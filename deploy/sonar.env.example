SONAR_BIND=127.0.0.1:3002
SONAR_DATA_DIR=/var/lib/sonar
RUST_LOG=info

# Require "Authorization: Bearer <key>" on API routes.
#SONAR_API_KEY=
#SEARXNG_ENDPOINT=http://127.0.0.1:8080
#SONAR_USER_AGENT=
# Ports allowed besides 80 and 443, comma separated.
#SONAR_EXTRA_PORTS=
# Limits (defaults shown).
#SONAR_GLOBAL_CONCURRENCY=256
#SONAR_PER_HOST_CONCURRENCY=2
#SONAR_PER_HOST_SPACING_MS=250
#SONAR_MAX_TIMEOUT_MS=120000
#SONAR_DEFAULT_MAX_AGE_MS=86400000
#SONAR_MAX_BODY_BYTES=10485760
# Browser tier (off unless one Chrome setting is present).
# Production: the confined unit in deploy/sonar-chrome.service.
#SONAR_CHROME_WS=http://127.0.0.1:9222
# Development only: launch a child Chrome (no OS egress confinement).
#SONAR_CHROME_PATH=/usr/bin/chromium
#SONAR_FORWARD_PROXY_PORT=3003
#SONAR_BROWSER_TABS=4
#SONAR_BROWSER_SESSIONS=2
#SONAR_BROWSER_RECYCLE_PAGES=200
#SONAR_BROWSER_MEMORY_MB=2048
# Base URL for screenshot links; defaults to http://<SONAR_BIND>.
#SONAR_PUBLIC_URL=

# Max characters per MCP tool result (agents)
# SONAR_MCP_MAX_CHARS=40000
